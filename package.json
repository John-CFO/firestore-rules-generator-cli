    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/figures": "^3.0.3",
    "@types/node": "^20.4.0",
    "eslint": "^8.51.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.29.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "ts-node": "^10.9.1",
    "typescript": "5.3.3"
  }
}
