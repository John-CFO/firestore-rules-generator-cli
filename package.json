{
  "name": "firestore-rules-cli",
  "version": "1.0.0",
  "description": "CLI to generate Firestore rules from rules.config.json + Zod (@AppSec)",
  "main": "dist/cli.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "frcli": "dist/cli.js"
  },
  "files": [
